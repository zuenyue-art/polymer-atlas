{
  "name": "polymer-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "高分子材料图鉴 —— 中文材料知识库静态站",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "python -m http.server 8080 --directory dist",
    "build": "npm run build:news && npm run build:prerender && npm run build:dark && npm run build:xlsx && npm run build:seo",
    "build:news": "node scripts/build-news.mjs",
    "build:prerender": "node scripts/prerender.mjs",
    "build:dark": "python scripts/build-dark-theme.py",
    "build:xlsx": "python scripts/build-xlsx.py",
    "build:seo": "node scripts/build-seo.mjs",
    "build:image": "python scripts/build-og-image.py",
    "check:news": "node scripts/build-news.mjs && git diff --exit-code -- dist/news-index.json dist/news",
    "check:xlsx": "python scripts/check-xlsx.py",
    "check:dark": "python scripts/build-dark-theme.py --check",
    "check:derived": "npm run check:news && npm run check:xlsx && npm run check:dark",
    "check:prerender": "node scripts/prerender.mjs --check",
    "check:seo": "node scripts/build-seo.mjs --check",
    "audit": "python scripts/audit.py .",
    "audit:strict": "python scripts/audit.py . --strict",
    "format": "prettier --write \"dist/**/*.{js,css,html}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"dist/**/*.{js,css,html}\" \"scripts/**/*.mjs\"",
    "check:links": "node scripts/check-links.mjs --concurrency=6 --timeout=20000",
    "check": "npm run check:derived && npm run check:prerender && npm run check:seo && npm run audit"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
