# 数据文件固定使用 LF 换行。
#
# dist/news-index.json 与 dist/news/** 由 scripts/build-news.mjs 生成，
# 该脚本写出的是 LF。若本机 core.autocrlf=true，git 检出为 CRLF，
# 重建后就会出现「内容相同却显示已修改」的假差异，干扰 npm run check:derived。
# 固定 eol=lf 后，Windows 与 CI 的比较结果一致。
*.json text eol=lf

# 源码同样钉死 LF。
# 原因：`.prettierrc.json` 里 endOfLine=lf，若本机检出为 CRLF，
# 在 Windows 上运行 `npm run format:check` 会报满屏假差异。
# 固定之后，Windows 与 CI 的格式检查结果一致。
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# scripts/build-seo.mjs 生成的 robots.txt 与 sitemap.xml 同样钉死 LF，
# 理由与上面的 JSON 一致：本机检出为 CRLF 时，重新生成会显示假差异，
# 干扰 npm run check:seo。
*.txt text eol=lf
*.xml text eol=lf
*.py text eol=lf

# 没有后缀的配置文件也钉死 LF，理由同上。
.prettierignore text eol=lf

# 工作流定义同样钉死 LF：YAML 对行尾不敏感，但检出成 CRLF 后再编辑，
# diff 会混进纯行尾的噪音，看不出真正改了哪一行。
*.yml text eol=lf
